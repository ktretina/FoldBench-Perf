{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "foldbench.pareto.artifact.v1",
  "title": "FoldBench Pareto Artifact v1",
  "type": "object",
  "required": [
    "schema",
    "artifact_version",
    "shard_id",
    "model_id",
    "checkpoint_sha256",
    "af3_input_sha256",
    "targets_total",
    "targets_completed",
    "expected_samples",
    "actual_samples",
    "completion_gate_ok",
    "walltime_seconds",
    "throughput_samples_per_min",
    "cost_proxy_gpu_seconds",
    "created_at_utc"
  ],
  "properties": {
    "schema": {"const": "foldbench.pareto.artifact.v1"},
    "artifact_version": {"type": "integer", "const": 1},
    "shard_id": {"type": "string"},
    "model_id": {"type": "string"},
    "variant_label": {"type": ["string", "null"]},
    "checkpoint_path": {"type": "string"},
    "checkpoint_sha256": {"type": "string"},
    "af3_input_json": {"type": "string"},
    "af3_input_sha256": {"type": "string"},
    "targets_total": {"type": "integer"},
    "targets_completed": {"type": "integer"},
    "segment_size": {"type": "integer"},
    "segments_total": {"type": "integer"},
    "segments_completed": {"type": "integer"},
    "seeds": {"type": "array", "items": {"type": "string"}},
    "samples_per_target": {"type": "integer"},
    "expected_samples": {"type": "integer"},
    "actual_samples": {"type": "integer"},
    "completion_gate_ok": {"type": "boolean"},
    "walltime_seconds": {"type": "number"},
    "throughput_samples_per_min": {"type": "number"},
    "cost_proxy_gpu_seconds": {"type": "number"},
    "quality_summary_path": {"type": ["string", "null"]},
    "quality_metric_primary": {"type": ["number", "null"]},
    "quality_metric_secondary": {"type": ["number", "null"]},
    "quality_notes": {"type": ["string", "null"]},
    "resume_state_json": {"type": "string"},
    "aggregate_pred_root": {"type": "string"},
    "created_at_utc": {"type": "string"}
  }
}
